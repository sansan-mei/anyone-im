# Production only: copy to .env and fill these before using Docker Compose.
# This file is NOT used automatically for local tests.
PUBLIC_ORIGIN=https://im.example.com
IM_PORT=4100
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Bind only on loopback by default. A containerized reverse proxy should join
# the relay-im network; see docs/deployment.md.
BIND_ADDRESS=127.0.0.1
