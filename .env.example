# Production application environment; never commit the filled .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=4100
DB_PROVIDER=mysql
PUBLIC_ORIGIN=https://im.mh33.top
DATA_DIR=/data
# Dedicated database/account in the EXISTING mysql container; not its root user.
# Example: mysql://anyone_im:URL_ENCODED_PASSWORD@mysql:3306/anyone_im
DATABASE_URL=
